# =====================================================================
# ARATHA RESEARCH & ANALYTICS - ENVIRONMENT CONFIGURATION
# =====================================================================

# NEXT ENVIRONMENT
NODE_ENV=development
PORT=3000

# NEO4J GRAPH DATABASE CONNECTION
# Supports Neo4j Desktop, Neo4j Aura (Cloud), or Self-Hosted Docker/Enterprise
# If left blank, the application automatically uses the resilient in-memory
# graph persistence engine with realistic enterprise seed data.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ADMIN PORTAL CREDENTIALS
# Used for protected administrative access to the enquiries & project pipeline
ADMIN_ACCESS_KEY=aratha-admin-2026
ADMIN_EMAIL=admin@aratharesearch.com

# TRANSACTIONAL EMAIL (Optional - logs to console in development)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
FROM_EMAIL=proposals@aratharesearch.com
